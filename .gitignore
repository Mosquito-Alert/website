# Hugo build artifacts
public/
resources/
.hugo_build.lock

# Logs and temporary files
*.log
*.tmp
.DS_Store

# Python tooling
__pycache__/
*.pyc
.venv/

# Node/Yarn caches (if pipelines use JS tooling)
node_modules/

# Specification build output
tools/spec-build/out/

# Handover data: the HTML snapshot and the crawl log stay local
handover/crawl/html/
handover/crawl/crawl.log
handover/media/*.tar
handover/media/fetch.log
